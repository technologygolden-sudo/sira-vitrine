# Modèle de variables d'environnement (copier en .env, ne jamais publier .env)
# Renseignées à l'étape 6, dans Cloudflare Pages > Settings > Environment variables.

# Clé secrète Cloudflare Turnstile (anti-spam du formulaire de devis)
TURNSTILE_SECRET_KEY=

# Service d'envoi d'email pour les demandes de devis
EMAIL_API_KEY=
DEVIS_DESTINATAIRE=businesscenter.sira@gmail.com
