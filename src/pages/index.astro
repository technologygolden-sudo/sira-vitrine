---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Bouton from '@/components/Bouton.astro';
import Carte from '@/components/Carte.astro';
import TitreSection from '@/components/TitreSection.astro';
import VousReconnaissez from '@/components/VousReconnaissez.astro';
import BandeauAction from '@/components/BandeauAction.astro';
import Faq from '@/components/Faq.astro';
import IllustrationExpertise from '@/components/IllustrationExpertise.astro';
import { SITE, lienWhatsApp } from '@/config/site';
import { EXPERTISES } from '@/data/expertises';
import { SECTEURS } from '@/data/secteurs';
import { METHODE } from '@/data/entreprise';
import { url } from '@/lib/url';
---
<BaseLayout>
  <!-- Bannière -->
  <section class="bg-nuit text-white">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-6 py-20 lg:grid-cols-2 lg:py-28">
      <div>
        <p class="inline-block rounded-full bg-orange/20 px-4 py-1 text-sm font-semibold text-orange-50">Solutions digitales & équipements professionnels</p>
        <h1 class="mt-6 text-4xl font-bold leading-tight text-white md:text-5xl">Équiper, connecter et sécuriser votre activité. Un seul partenaire.</h1>
        <p class="mt-6 text-lg text-nuit-50">Des solutions modernes pour faire évoluer votre entreprise. Nous partons de votre besoin réel pour concevoir, installer et faire évoluer les solutions qui vous font gagner du temps et de la sérénité.</p>
        <div class="mt-10 flex flex-wrap gap-4">
          <Bouton href="#vous-reconnaissez-vous">Trouver ma solution</Bouton>
          <Bouton href={lienWhatsApp()} variante="contour-clair" externe>Discuter sur WhatsApp</Bouton>
        </div>
      </div>
      <ul class="grid grid-cols-2 gap-4">
        {METHODE.slice(0, 4).map((e, i) => (
          <li class:list={['rounded-2xl border p-5', i === 3 ? 'border-orange/50 bg-orange/15' : 'border-white/15 bg-white/5']}>
            <p class="font-titre text-lg font-semibold text-white">{e.titre}</p>
            <p class="mt-1 text-sm text-nuit-50">{e.texte}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Bandeau de confiance -->
  <section aria-label="Nos engagements" class="border-b border-bordure bg-white">
    <ul class="mx-auto grid max-w-6xl gap-6 px-6 py-8 text-center sm:grid-cols-2 lg:grid-cols-4">
      <li><p class="font-titre font-semibold text-nuit">Écoute avant tout</p><p class="text-sm text-texte-doux">Votre besoin réel d’abord</p></li>
      <li><p class="font-titre font-semibold text-nuit">Une seule équipe</p><p class="text-sm text-texte-doux">Équipement, réseau, logiciel, suivi</p></li>
      <li><p class="font-titre font-semibold text-nuit">Proximité</p><p class="text-sm text-texte-doux">Basés à Abidjan</p></li>
      <li><p class="font-titre font-semibold text-nuit">Disponibles</p><p class="text-sm text-texte-doux">{SITE.horaires}</p></li>
    </ul>
  </section>

  <VousReconnaissez />

  <!-- Expertises -->
  <section class="py-20">
    <div class="mx-auto max-w-6xl px-6">
      <TitreSection surTitre="Nos expertises" titre="Cinq expertises, une seule équipe" intro="Nous ne vendons pas seulement des équipements : nous concevons la solution complète et restons à vos côtés après l’installation." />
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {EXPERTISES.map((e) => (
          <Carte titre={e.titre} href={`/expertises/${e.slug}`}>
            <IllustrationExpertise slot="illustration" expertise={e} />
            {e.resume}
          </Carte>
        ))}
      </div>
    </div>
  </section>

  <!-- Secteurs -->
  <section class="bg-white py-20">
    <div class="mx-auto max-w-6xl px-6">
      <TitreSection surTitre="Votre secteur" titre="Des solutions pour chaque environnement" />
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {SECTEURS.map((s) => (
          <li>
            <a href={url(`/secteurs/${s.slug}`)} class="flex h-full flex-col rounded-2xl border border-bordure p-5 transition hover:border-orange hover:shadow-lg">
              <span class="font-titre text-lg font-semibold text-nuit">{s.nom}</span>
              <span class="mt-2 text-sm text-texte-doux">{s.intro}</span>
              <span class="mt-auto pt-3 text-sm font-bold text-orange-700">{s.pack} →</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Méthode -->
  <section class="py-20">
    <div class="mx-auto max-w-6xl px-6">
      <TitreSection surTitre="Notre méthode" titre="Comment nous travaillons" />
      <ol class="grid gap-4 md:grid-cols-5">
        {METHODE.map((e, i) => (
          <li class="rounded-2xl bg-white p-5">
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-orange font-titre font-bold text-nuit">{i + 1}</span>
            <p class="mt-3 font-titre font-semibold text-nuit">{e.titre}</p>
            <p class="mt-1 text-sm text-texte-doux">{e.texte}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Faq />
  <BandeauAction />
</BaseLayout>
