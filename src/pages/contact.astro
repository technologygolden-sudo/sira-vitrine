---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Bouton from '@/components/Bouton.astro';
import FormulaireDevis from '@/components/FormulaireDevis.astro';
import { SITE, lienWhatsApp } from '@/config/site';
const carte = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(SITE.adresse)}`;
---
<BaseLayout titre="Contact & devis" description="Contactez SIRA Business Center à Abidjan : devis en ligne, WhatsApp, téléphone et email.">
  <section class="bg-nuit py-16 text-white">
    <div class="mx-auto max-w-6xl px-6">
      <p class="text-sm font-bold uppercase tracking-widest text-orange">Contact & devis</p>
      <h1 class="mt-3 text-4xl font-bold text-white md:text-5xl">Parlons de votre projet</h1>
      <p class="mt-4 max-w-2xl text-lg text-nuit-50">Notre équipe vous répond et vous oriente vers la solution adaptée.</p>
    </div>
  </section>

  <section class="py-16">
    <div class="mx-auto grid max-w-6xl gap-10 px-6 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <h2 class="mb-6 text-2xl font-bold">Demande de devis en 4 étapes</h2>
        <FormulaireDevis />
      </div>
      <aside class="space-y-4">
        <div class="rounded-carte bg-white p-6">
          <h2 class="text-xl font-bold">Nos coordonnées</h2>
          <dl class="mt-4 space-y-3">
            <div><dt class="text-sm text-texte-doux">Téléphone / WhatsApp</dt><dd><a href={`tel:${SITE.telephoneLien}`} class="font-semibold hover:text-orange-700">{SITE.telephone}</a></dd></div>
            <div><dt class="text-sm text-texte-doux">Email</dt><dd><a href={`mailto:${SITE.email}`} class="font-semibold break-all hover:text-orange-700">{SITE.email}</a></dd></div>
            <div><dt class="text-sm text-texte-doux">Adresse</dt><dd class="font-semibold">{SITE.adresse}</dd></div>
            <div><dt class="text-sm text-texte-doux">Horaires</dt><dd class="font-semibold">{SITE.horaires}</dd></div>
          </dl>
          <div class="mt-6 flex flex-col gap-3">
            <Bouton href={lienWhatsApp()} externe>Écrire sur WhatsApp</Bouton>
            <Bouton href={carte} variante="contour" externe>Voir sur Google Maps</Bouton>
          </div>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
