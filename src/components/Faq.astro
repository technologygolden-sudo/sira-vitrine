---
import { FAQ } from '@/data/entreprise';
import TitreSection from './TitreSection.astro';
---
<section class="bg-white py-20">
  <div class="mx-auto max-w-3xl px-6">
    <TitreSection titre="Questions fréquentes" centre />
    <div class="space-y-3">
      {FAQ.map((item) => (
        <details class="group rounded-2xl border border-bordure bg-fond">
          <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 p-5 font-semibold [&::-webkit-details-marker]:hidden">
            {item.q}
            <span class="text-2xl text-orange-700 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="px-5 pb-5 text-texte-doux">{item.r}</p>
        </details>
      ))}
    </div>
  </div>
</section>
