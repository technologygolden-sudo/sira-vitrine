---
// Affiche la photo réaliste d'une expertise si elle existe dans img/,
// sinon l'illustration vectorielle aux couleurs SIRA (jamais d'image cassée).
import { Image } from 'astro:assets';
import type { Expertise } from '@/data/expertises';
import { imageProjet } from '@/lib/photos';

interface Props {
  expertise: Expertise;
  variante?: 'carte' | 'grande';
}
const { expertise, variante = 'carte' } = Astro.props;
const photo = imageProjet(expertise.photo);
const hauteur = variante === 'grande' ? 'h-80 md:h-96' : 'h-48';
---
{photo ? (
  <Image
    src={photo}
    alt={expertise.photoAlt ?? ''}
    width={variante === 'grande' ? 900 : 600}
    height={variante === 'grande' ? 640 : 400}
    class:list={['w-full object-cover', hauteur, variante === 'grande' && 'rounded-carte']}
    loading={variante === 'grande' ? 'eager' : 'lazy'}
  />
) : (
  <div
    class:list={['flex items-center justify-center bg-orange-50 p-4 [&>svg]:h-full [&>svg]:w-full', hauteur, variante === 'grande' && 'rounded-carte']}
    set:html={expertise.illustration}
  />
)}
