---
import Bouton from './Bouton.astro';
import { lienWhatsApp } from '@/config/site';
interface Props { titre?: string; texte?: string; }
const {
  titre = 'Un projet ? Parlons-en.',
  texte = 'Un conseiller SIRA analyse votre situation et vous propose la solution adaptée.',
} = Astro.props;
---
<section class="bg-nuit py-16 text-white">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-6 px-6">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-bold text-white">{titre}</h2>
      <p class="mt-3 text-nuit-50">{texte}</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <Bouton href={lienWhatsApp()} externe>Écrire sur WhatsApp</Bouton>
      <Bouton href="/contact#devis" variante="contour-clair">Demander un devis</Bouton>
    </div>
  </div>
</section>
